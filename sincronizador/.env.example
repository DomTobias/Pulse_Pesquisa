# Sincronizador Pulse — copie para .env e preencha. O .env NUNCA vai para o controle de versão.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=pulse-capas

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pulse
MYSQL_USER=pulse_sync
MYSQL_PASSWORD=

# Intervalos em segundos
INTERVALO_SINCRONIZACAO=30
INTERVALO_PUBLICACAO=20
# Tempo (s) que um lote fica reservado antes de voltar à fila
TEMPO_RESERVA=300
LIMITE_REGISTROS_POR_LOTE=50
# Tentativas de publicação antes de marcar ERRO (a fila do Supabase usa o parâmetro max_tentativas)
MAX_TENTATIVAS=5

# Pasta de imagens enviadas pelo gerenciador (capas e símbolos)
UPLOADS_DIR=../gerenciador/storage/uploads
LOG_DIR=logs
LOG_RETENCAO_DIAS=30
